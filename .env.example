APP_ENV=development
HTTP_ADDR=:8080

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=fluffcatch
MYSQL_PASSWORD=fluffcatch
MYSQL_DATABASE=fluffcatch
MYSQL_CHARSET=utf8mb4
MYSQL_LOCATION=Local
MYSQL_CONNECT_ON_START=true

# 首次启动/无数据库时的默认存储策略；正式配置会保存在数据库 settings 表中。
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=data/uploads
STORAGE_PUBLIC_PREFIX=/media
# 非本地存储策略建议在后台配置 Public Base URL/CDN 地址；本地可留空。
STORAGE_PUBLIC_BASE_URL=

ADMIN_USERNAME=admin
SESSION_SECRET=change-me-in-production

FRONTEND_MODE=auto
